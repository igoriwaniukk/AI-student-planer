# Copy this file to .env and fill in your own Supabase project's values to
# turn on real accounts + cross-device sync (see supabase/schema.sql for the
# one-time database setup). Leave .env absent/empty and the app keeps
# working exactly as before, on localStorage alone, no account needed.
#
# Get both values free at https://supabase.com — create a project, then
# Project Settings → API. The "anon" key is meant to be public (it's the
# key browsers use); real protection comes from the Row Level Security
# policies in supabase/schema.sql, so never skip running that file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
