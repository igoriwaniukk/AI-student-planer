# Copy this file to server/.env and fill in your own key.
# Get a key at https://platform.openai.com/ (API keys section) — never commit
# the real .env file or share this key with anyone.
OPENAI_API_KEY=

# Optional: override the default model (check your OpenAI dashboard for the
# exact current model name available to your account).
# OPENAI_MODEL=gpt-4o-mini

# Optional: change the port the chat server listens on (default 8787).
# PORT=8787
