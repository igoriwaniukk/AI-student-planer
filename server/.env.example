# Copy this file to server/.env and fill in your own key.
# Get a key at https://console.anthropic.com/settings/keys. Never commit the
# real .env file or share this key with anyone.
ANTHROPIC_API_KEY=

# Optional: override the default model.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: change the port the chat server listens on (default 8787).
# PORT=8787

# Push notifications ("Enable phone notifications" in the app's bell menu).
# Generate your own pair once with: npx web-push generate-vapid-keys
# Never share the private key or commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address VAPID requires (a mailto: link or your site's URL).
VAPID_CONTACT=mailto:example@example.com

# Optional: how often the server checks and sends a push to each
# subscribed device (default 60). Lower this for local testing.
# PUSH_INTERVAL_MINUTES=60

# Required for push notifications: lets the server read/write subscribed
# devices in Supabase (see supabase/schema.sql's push_subscriptions table).
# Get it from your Supabase project's Settings -> API -> "service_role"
# secret key — NOT the same as the anon key used by the browser. Never
# expose this key to the client or commit it; it bypasses all Row Level
# Security.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, production only: set this to a random secret and add the same
# value as a Vercel environment variable — Vercel Cron then sends it as
# `Authorization: Bearer <value>` when it triggers api/push/cron.js, so
# nobody else can trigger a push send by guessing the URL.
# CRON_SECRET=
