# Copy this file to server/.env and fill in your own key.
# Get a free key at https://aistudio.google.com/ (click "Get API key") — no
# credit card required for the free tier. Never commit the real .env file
# or share this key with anyone.
GEMINI_API_KEY=

# Optional: override the default model (check Google AI Studio's model
# picker for the exact current free-tier model name).
# GEMINI_MODEL=gemini-3.6-flash

# Optional: change the port the chat server listens on (default 8787).
# PORT=8787

# Push notifications ("Enable phone notifications" in the app's bell menu).
# Generate your own pair once with: npx web-push generate-vapid-keys
# Never share the private key or commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address VAPID requires (a mailto: link or your site's URL).
VAPID_CONTACT=mailto:example@example.com

# Optional: how often the server checks and sends a push to each
# subscribed device (default 60). Lower this for local testing.
# PUSH_INTERVAL_MINUTES=60
